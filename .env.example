# Optional — copy to .env and fill in, or set real env vars instead (they take precedence, no file needed). Never committed (see .gitignore).

# Météo-France API key — Données radar (current mosaic, 1 frame)
# Required for the "MF Cumul" source (otherwise the app falls back to OPERA ACRR).
# Portal: portail-api.meteofrance.fr → product "Données radar"
MF_RADAR_API_KEY=your_radar_key_here

# Météo-France API key — AROME-PI (CAPE grid, WCS).
# Required for /api/cape (otherwise stays at 503).
# Portal: portail-api.meteofrance.fr → product "Modèle AROME Prévision Immédiate"
MF_AROMEPI_API_KEY=your_aromepi_key_here

# Météo-France API key — Package Observations (real-time stations, interpolated wind grid).
# Required for /api/wind (otherwise stays at 503).
# Portal: portail-api.meteofrance.fr → product "Package Observations"
MF_PACKAGE_OBS_API_KEY=your_obs_key_here

# Météo-France API key — PIAF (0-3h precipitation forecast, runs every 5 min).
# Required for the "Prévision" layer (otherwise that source stays unavailable).
# Portal: portail-api.meteofrance.fr → product "Modèle AROME Prévision Immédiate Agrégée Fusionnée (PIAF)"
MF_PIAF_API_KEY=your_piaf_key_here

# Météo-France API key — Bulletin Vigilance (level/phenomenon per department).
# Required for /api/vigilance (otherwise stays at 503) and the dashboard's vigilance alerts.
# Portal: portail-api.meteofrance.fr → product "Bulletin Vigilance"
MF_VIGILANCE_KEY=your_vigilance_key_here

# Optional
# FETCH_INTERVAL_SEC=300
# MAX_FRAMES=24
# MAX_FRAME_AGE_MIN=120
# FRAMES_DIR=/app/frames
# HOST=0.0.0.0
# PORT=5000
# NGINX_PORT=8080
# HOST_PORT=80
# BLITZORTUNG_MQTT_HOST=blitzortung.ha.sed.pl
# BLITZORTUNG_MQTT_PORT=1883
